# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/app/build/
/app/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/app/android/app/debug
/app/android/app/profile
/app/android/app/release

# Android signing — never commit to version control
**/key.properties
**/*.keystore
**/*.jks

# Firebase credentials (contain API keys — never commit to public repos)
**/google-services.json
**/GoogleService-Info.plist
app/lib/firebase_options.dart
.firebaserc
.firebase/

# AEMET OpenData API key — never commit to public repos
app/assets/aemet_key.txt

# CocoaPods dependencies (generated, not source)
**/Pods/

# Flutter ephemeral generated files
**/Flutter/ephemeral/

# Claude Code local settings (permissions, user-specific config)
.claude/settings.local.json
